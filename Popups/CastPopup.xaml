<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
               x:Class="FilmManager.Popups.CastPopup"
               CanBeDismissedByTappingOutsideOfPopup="False">
    <VerticalStackLayout>
        <Label Text="{Binding Name}" 
               TextColor="Black" />
        <Label Text="{Binding AlsoKnownAs}"
               TextColor="Black"/>
        <Label Text="{Binding Birthday}" 
               TextColor="Black"/>
        <Label Text="{Binding PlaceOfBirth}"
               TextColor="Black"/>
        <Label Text="{Binding Gender}" 
               TextColor="Black"/>
        <Label Text="{Binding KnownForDepartment}" 
               TextColor="Black"/>
        <Label Text="{Binding Popularity}"
               TextColor="Black"/>
        <Label Text="{Binding Biography}"
               TextColor="Black"/>
        <Button Text="{x:Static strings:AppResources.close}"
                BackgroundColor="Red"
                TextColor="Black"
                Clicked="ClosePopup" />
    </VerticalStackLayout>
</toolkit:Popup>