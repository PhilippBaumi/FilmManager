<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
               x:Class="FilmManager.Views.OnClickPopup"
               BackgroundColor="Grey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Grid.Row="0" Text="{x:Static strings:AppResources.removeFromList}" Clicked="RemoveFromList" />
        <Button Grid.Column="0" Grid.Row="1" Text="{x:Static strings:AppResources.toDetails}" Clicked="NavigateToDetails" />
        <Button Text="{x:Static strings:AppResources.toCollection}" Clicked="NavigateToCollection"/>
        <Button Grid.Column="0" Grid.Row="2" Text="{x:Static strings:AppResources.close}" Clicked="HandleClose" BackgroundColor="#FF0000"/>
    </Grid>
</toolkit:Popup>