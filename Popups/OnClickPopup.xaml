<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="FilmManager.Popups.OnClickPopup"
               xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
               BackgroundColor="Grey">
    <VerticalStackLayout>
        <Label x:Name="lbTitle" HorizontalOptions="Center" FontSize="15" FontAttributes="Bold"/>
        <Button x:Name="btnMarkedAsWatched"
                Text="{x:Static strings:AppResources.markAsWatched}"
                Clicked="MarkAsWatched"/>
        <Button Text="{x:Static strings:AppResources.remove}"
                Clicked="HandleRemove"/>
        <Button Text="{x:Static strings:AppResources.toDetails}"
                Clicked="NavigateToDetail"/>
        <Button Text="{x:Static strings:AppResources.close}" 
                Clicked="HandleClose" 
                BackgroundColor="#FF0000"/>
    </VerticalStackLayout>
</toolkit:Popup>