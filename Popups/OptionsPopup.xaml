<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="FilmManager.Popups.OptionsPopup"
               xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
               BackgroundColor="Grey">
    <VerticalStackLayout>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="0" 
                    Grid.Row="0" 
                    Text="{x:Static strings:AppResources.addToWatched}" 
                    Clicked="AddToWatched" />
            <Button Grid.Column="1" 
                    Grid.Row="0" 
                    Text="{x:Static strings:AppResources.addToWatchlist}" 
                    Clicked="AddToWatchlist" />
            <Button Grid.Column="0" 
                    Grid.Row="1" 
                    Text="{x:Static strings:AppResources.toDetails}" 
                    Clicked="NavigateToDetails" />
            <Button Grid.Column="1" 
                    Grid.Row="1" 
                    Text="{x:Static strings:AppResources.collection}" 
                    Clicked="NavigateToCollection"/>
        </Grid>
        <Button Grid.Column="0" 
                Grid.Row="2" 
                Text="{x:Static strings:AppResources.close}" 
                Clicked="HandleClose" 
                BackgroundColor="#FF0000"/>
    </VerticalStackLayout>
</toolkit:Popup>
