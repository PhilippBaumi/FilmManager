<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="FilmManager.CollectionPage"
             Title="CollectionPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout Padding="20"
                         Spacing="25">
        <skia:SKCanvasView x:Name="HeaderCanvas"
                   HeightRequest="100"
                   PaintSurface="HandlePaintSurface" />
        <Grid RowDefinitions="Auto,Auto,*"
              Padding="20">
            <Entry Grid.Row="0" 
                   x:Name="entrySearchCollection" 
                   Placeholder="{x:Static strings:AppResources.searchCollectionPlaceholder}"
                   Completed="OnCompleted"/>
            <Button Grid.Row="1" 
                    Text="{x:Static strings:AppResources.search}" 
                    Clicked="SearchCollection" />
            <CollectionView Grid.Row="2" 
                            ItemsSource="{Binding Images}"
                            SelectedItem="{Binding SelectedItem}"
                            SelectionMode="Single"
                            SelectionChanged="GetCollectionToImage">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="3" 
                                     HorizontalItemSpacing="10" 
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border HeightRequest="200" 
                                WidthRequest="150" 
                                HorizontalOptions="Center">
                            <Image Source="{Binding .}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>