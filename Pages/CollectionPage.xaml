<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
             x:Class="FilmManager.CollectionPage">
    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <skia:SKCanvasView Grid.Row="0"
                           PaintSurface="HandlePaintSurface" />
        <Entry Grid.Row="1" 
               x:Name="entrySearchCollection" 
               Placeholder="{x:Static strings:AppResources.searchCollectionPlaceholder}"
               Completed="OnCompleted"/>
        <Button Grid.Row="2" 
                Text="{x:Static strings:AppResources.search}" 
                Clicked="SearchCollection" />
        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding Images}"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionChanged="GetCollectionToImage">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="3"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Image Source="{Binding .}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>