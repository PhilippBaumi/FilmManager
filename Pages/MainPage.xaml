<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmManager.MainPage">
    <!--Padding="0,60,0,0">-->
    <VerticalStackLayout>
        <skia:SKCanvasView x:Name="HeaderCanvas"
                           PaintSurface="HandlePaintSurface" />
        <Button Text="{x:Static strings:AppResources.resetDatabase}"
                Clicked="ResetDatabase"
                WidthRequest="250"/>
        <Picker Title="{x:Static strings:AppResources.series}"
                ItemsSource="{Binding Serien}"
                SelectedItem="{Binding SelectedSerie, Mode=TwoWay}"
                SelectedIndexChanged="OnPickerSeriesSelectionChanged"/>
        <Picker Title="{x:Static strings:AppResources.movies}"
                ItemsSource="{Binding Movies}"
                SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                SelectedIndexChanged="OnPickerMoviesSelectionChanged"/>
    </VerticalStackLayout>
</ContentPage>
