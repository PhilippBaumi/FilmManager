<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmManager.WatchlistWatchedPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout>
        <skia:SKCanvasView x:Name="HeaderCanvas"
                           PaintSurface="HandlePaintSurface" />
        <Picker Title="{x:Static strings:AppResources.watched}"
                ItemsSource="{Binding Watched,Mode=TwoWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectedIndexChanged="HandlePickerSelection"/>
        <Picker Title="{x:Static strings:AppResources.watchlist}"
                ItemsSource="{Binding Watchlist, Mode=TwoWay}"
                SelectedItem="{Binding SelectedItem}"
                SelectedIndexChanged="HandlePickerSelection"/>
    </VerticalStackLayout>
</ContentPage>