<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmManager.SaveLoadPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout>
        <StackLayout x:Name="SaveOrLoadGroup" 
                     Padding="20"
                     RadioButtonGroup.GroupName="Save">
            <RadioButton Content="DOCX" 
                         Value="DOCX" 
                         CheckedChanged="SaveOrLoad"/>
            <!--Margin="10"/>-->
            <RadioButton Content="CSV" 
                         Value="CSV" 
                         CheckedChanged="SaveOrLoad"/>
            <!--Margin="10"/>-->
            <RadioButton Content="JSON" 
                         Value="JSON" 
                         CheckedChanged="SaveOrLoad"/>
            <!--Margin="10"/>-->
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>