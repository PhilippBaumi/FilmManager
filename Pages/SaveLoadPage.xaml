<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="FilmManager.SaveLoadPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout Padding="20"
                         Spacing="25">
        <skia:SKCanvasView x:Name="HeaderCanvas"
                           HeightRequest="100"
                           PaintSurface="HandlePaintSurface" />
        <StackLayout x:Name="SaveOrLoadGroup" 
                     Padding="20"
                     RadioButtonGroup.GroupName="Save">
            <RadioButton Content="DOCX" 
                         Value="DOCX" 
                         CheckedChanged="SaveOrLoad"/>
            <RadioButton Content="CSV" 
                         Value="CSV" 
                         CheckedChanged="SaveOrLoad"/>
            <RadioButton Content="JSON" 
                         Value="JSON" 
                         CheckedChanged="SaveOrLoad"/>
            </StackLayout>
    </VerticalStackLayout>
</ContentPage>