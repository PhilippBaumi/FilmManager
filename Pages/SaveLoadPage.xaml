<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmManager.SaveLoadPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout>
        <StackLayout x:Name="SaveOrLoadGroup" Margin="10" RadioButtonGroup.GroupName="Save">
            <RadioButton Content="PDF" Value="PDF" CheckedChanged="SaveOrLoad"/>
            <RadioButton Content="DOCX" Value="DOCX" CheckedChanged="SaveOrLoad"/>
            <RadioButton Content="CSV" Value="CSV" CheckedChanged="SaveOrLoad"/>
            <RadioButton Content="JSON" Value="JSON" CheckedChanged="SaveOrLoad"/>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>