<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilmManager.SettingPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen">
    <VerticalStackLayout Padding="20">
        <Picker Title="{x:Static strings:AppResources.language}"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding Language, Mode=TwoWay}"
                SelectedIndexChanged="HandlePickerLanguage"/>
        <Picker Title="Design/Theme"
                ItemsSource="{Binding Themes}"
                SelectedItem="{Binding ThemeAsString, Mode=TwoWay}"/>
    </VerticalStackLayout>
</ContentPage>