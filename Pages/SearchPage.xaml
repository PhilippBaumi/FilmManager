<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
             x:Class="FilmManager.SearchPage">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
        <skia:SKCanvasView Grid.Row="0"
                           PaintSurface="HandlePaintSurface" />
        <Entry x:Name="entrySearch" 
               Grid.Row="1" 
               Placeholder="{x:Static strings:AppResources.search}"/>
        <StackLayout Grid.Row="2" 
                     RadioButtonGroup.GroupName="Type">
            <RadioButton x:Name="rbMovie" 
                         Content="{x:Static strings:AppResources.movie}" 
                         Value="{x:Static strings:AppResources.movie}"/>
            <RadioButton x:Name="rbTv" 
                         Content="TV" 
                         Value="TV"/>
        </StackLayout>
        <Button Grid.Row="3" 
                Text="{x:Static strings:AppResources.search}" 
                Clicked="Search" />
        <CollectionView Grid.Row="4" 
                        ItemsSource="{Binding Images}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionChanged="GetSearchToImage">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Image Source="{Binding .}"
                               />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>