<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="FilmManager.SearchPage"
             xmlns:strings="clr-namespace:FilmManager.Resources.Strings.Sprachen"
             Title="SearchPage">
    <VerticalStackLayout Padding="20" 
                         Spacing="25">
        <skia:SKCanvasView x:Name="HeaderCanvas"
                   HeightRequest="100"
                   PaintSurface="HandlePaintSurface" />
        <Grid RowDefinitions="Auto, Auto, Auto, *"
              Padding="20">
            <Entry x:Name="entrySearch" 
                   Grid.Row="0" 
                   Placeholder="{x:Static strings:AppResources.search}"/>
            <StackLayout Grid.Row="1" 
                         Margin="10" 
                         RadioButtonGroup.GroupName="Type">
                <RadioButton x:Name="rbMovie" 
                             Content="{x:Static strings:AppResources.movie}" 
                             Value="{x:Static strings:AppResources.movie}"/>
                <RadioButton x:Name="rbTv" 
                             Content="TV" 
                             Value="TV"/>
            </StackLayout>
            <Button Grid.Row="2" 
                    Text="{x:Static strings:AppResources.search}" 
                    Clicked="Search" />
            <CollectionView Grid.Row="3" 
                            ItemsSource="{Binding Images}"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                            SelectionMode="Single"
                            SelectionChanged="GetSearchToImage">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="3" 
                                     HorizontalItemSpacing="10" 
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border HeightRequest="200" 
                                WidthRequest="150" 
                                HorizontalOptions="Center">
                            <Image Source="{Binding .}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>